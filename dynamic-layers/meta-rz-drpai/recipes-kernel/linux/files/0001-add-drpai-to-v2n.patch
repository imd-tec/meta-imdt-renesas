+++ b/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts
@@ -80,6 +80,13 @@ drp_reserved: DRP-AI@D0000000 {
 	};
 
 };
+
+&drpai0 {
+	memory-region = <&drp_reserved>;
+	memory-shared-for-drpai-ext-cont = <&shared_drp_reserved>;
