---
 arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts | 7 +++++++
 1 file changed, 7 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts b/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts
index 37b6f99d90e0..1b3b4d9a79ec 100644
