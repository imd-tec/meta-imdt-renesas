         {
             /* The DRP-AI is running. Therefore, stop the DRP-AI first. */
@@ -646,6 +650,7 @@ static int drp_close(struct inode *inode, struct file *file)
             }
 
 #ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
