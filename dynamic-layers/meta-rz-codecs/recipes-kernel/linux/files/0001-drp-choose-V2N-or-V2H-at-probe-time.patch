From ed1131ccbabbbbb2faf863a165190f374a76456d Mon Sep 17 00:00:00 2001
From: Ugur Acikgoz <ugur.acikgoz@imd-tec.com>
Date: Thu, 12 Nov 2026 10:24:28 +0000
Subject: [PATCH] drp: choose V2N or V2H at probe time

The driver picked the SoC with #if CONFIG_ARCH_R9A09G056, so a kernel
built for both the V2N and the V2H ran the V2N code on the V2H. Probe
then asked for the V2N-only AI-MAC region and failed, and video decode
fell back to the CPU.

Read the compatible at probe instead. The V2N paths (AI-MAC, memory
shared with DRP-AI, shared reset and error IRQ, CPG init) now run only
on a V2N. Single-SoC builds behave as before.
---
 drivers/drp/drp-core.c |  43 +++-------------
 drivers/drp/drp-core.h |   3 +-
 drivers/drp/drp-if.c   | 108 +++++++++++++++++++++++------------------
 3 files changed, 68 insertions(+), 86 deletions(-)

diff --git a/drivers/drp/drp-core.c b/drivers/drp/drp-core.c
index 29e513d..66eb1f5 100644
--- a/drivers/drp/drp-core.c
+++ b/drivers/drp/drp-core.c
@@ -79,11 +79,7 @@ static void enable_drp_swreset(addr_t drp_base_addr);
 static void enable_addr_relocatable_drp(addr_t drp_base_addr, uint64_t* addr);
 static void disable_adrconv_drp(addr_t drp_base_addr);
 static void enable_adrconv_drp(addr_t drp_base_addr);
-#if defined(CONFIG_ARCH_R9A09G056)
 static void disable_addr_relocatable_func(addr_t drp_base_addr, addr_t aimac_base_addr);
-#else
-static void disable_addr_relocatable_func(addr_t drp_base_addr);
-#endif
