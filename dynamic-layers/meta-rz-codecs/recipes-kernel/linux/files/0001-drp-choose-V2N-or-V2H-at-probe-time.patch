     R_DRP_UnlockDrpaiContStatus(drp_shared_exclusion,
                                 &shared_mem_lock,
                                 INTERRUPT_CONTEXT,
@@ -1059,7 +1065,8 @@ static irqreturn_t irq_drp_errint(int irq, void *dev)
 
     spin_lock_irqsave(&priv->lock, flags);
 #ifdef ENABLE_DRP_SUPPORT_SHARED_MEMORY
-    flag_drp_shared_used = R_DRP_IsDrpaiContStatusLocked(drp_shared_exclusion, DRPFLAG_DRP_LOCK);
+    /* 1 = no shared memory: handle the interrupt, nothing to unlock */
+    flag_drp_shared_used = drp_is_v2n ? R_DRP_IsDrpaiContStatusLocked(drp_shared_exclusion, DRPFLAG_DRP_LOCK) : 1;
     if(-1 == flag_drp_shared_used)
     {
         ret = IRQ_HANDLED;
@@ -1184,6 +1191,14 @@ static int drp_regist_device(struct platform_device *pdev)
     drp_priv = priv;
     refcount_set(&priv->count, 1);
 
+    drp_is_v2n = of_device_is_compatible(pdev->dev.of_node, "renesas,rzv2n-drp");
