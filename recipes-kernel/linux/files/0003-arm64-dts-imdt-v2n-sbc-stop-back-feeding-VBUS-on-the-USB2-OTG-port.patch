From 0000000000000000000000000000000000000000 Mon Sep 17 00:00:00 2001
From: ugur-imd <ugur.acikgoz@imd-tec.com>
Date: Fri, 9 Oct 2026 16:22:05 +0100
Subject: [PATCH] arm64: dts: imdt-v2n-sbc: stop back-feeding VBUS on the USB2
 OTG port

The 6.1 device tree rework pointed usb2_phy0's vbus-supply at the PHY's
internal vbus-regulator. The driver enables that regulator at probe and
can only switch it off again for a GPIO-controlled supply, so VBUS stays
on even when the V2N is the USB device. The host on the other end (a PC,
or the LAVA worker) then sees VBUS back-feed and trips its over-current
protection.

Disable the internal regulator on imdt-v2n-sbc and give the PHY a plain
fixed supply instead. The PHY then drives VBUS through VBOUT according
to the OTG role, as it did on dunfell: off as a device, on as a host.
---
 arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts | 21 ++++++++++++++++++++
 1 file changed, 21 insertions(+)

diff --git a/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts b/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts
index 54e5fa9..34f6140 100644
--- a/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts
+++ b/arch/arm64/boot/dts/renesas/imdt-v2n-sbc.dts
@@ -7,6 +7,14 @@
 / {
 	model = "IMDT V2N SBC";
 	compatible = "imdt,v2n-sbc", "renesas,r9a09g056n44", "renesas,r9a09g056";
+
+	/* VBUS on the OTG port is switched by the PHY itself (VBOUT), per role. */
+	usb20_vbus: regulator-usb20-vbus {
+		compatible = "regulator-fixed";
+		regulator-name = "usb20-vbus";
+		regulator-min-microvolt = <5000000>;
+		regulator-max-microvolt = <5000000>;
+	};
 	/*Only one memory chip on the V2N */
 	memory@48000000 {
 		device_type = "memory";
@@ -92,3 +100,16 @@
 	status = "okay";
 };
 
+/*
+ * The PHY's internal vbus-regulator is switched on at probe and the driver
+ * cannot switch it off again, so the board back-feeds VBUS into the host it
+ * is attached to as a device. Use a plain supply instead, so VBUS follows
+ * the OTG role as it did on dunfell.
+ */
+&usb2_phy0_vbus_otg {
+	status = "disabled";
+};
+
+&usb2_phy0 {
+	vbus-supply = <&usb20_vbus>;
+};
